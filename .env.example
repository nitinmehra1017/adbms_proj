# Backend server
PORT=5000

# MySQL connection (never commit your real .env file)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healthcare_ai_db

# Local databases used for the federated healthcare simulation
HOSPITAL_A_DB=hospital_a_db
HOSPITAL_B_DB=hospital_b_db

# Gemini is called only from the backend. Keep the real API key in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Authentication (keep the real secret only in backend/.env)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
